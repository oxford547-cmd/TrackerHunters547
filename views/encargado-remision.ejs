<%- include('partials/head', { withSidebar: true }) %>
<div class="dash-head no-print">
  <div>
    <h1 class="dash-title lime">Remisión folio <%= remision.folio %></h1>
    <p class="muted">Provisional · <%= remision.fecha %></p>
  </div>
  <div class="dash-actions">
    <a class="btn btn-glass" href="/encargado/remisiones">Listado</a>
    <button type="button" class="btn btn-glass-hot" onclick="window.print()">Imprimir</button>
  </div>
</div>

<div class="card remision-sheet">
  <div class="remision-head">
    <img class="logo-preview" src="<%= logo %>" alt="Logo">
    <div>
      <h2><%= remision.company_name || (portal && portal.name) || brandName %></h2>
      <p class="muted small"><%= remision.company_address || '' %></p>
      <p><strong>Remisión provisional Nº <%= remision.folio %></strong></p>
      <p class="muted small">Fecha: <%= remision.fecha %></p>
    </div>
  </div>
  <p>Cliente: <strong><%= remision.customer_name %></strong></p>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Cant.</th>
          <th>Unidad</th>
          <th>Descripción</th>
          <th>Lote</th>
          <th>Importe</th>
        </tr>
      </thead>
      <tbody>
        <% items.forEach(it => { %>
        <tr>
          <td><%= it.cantidad %></td>
          <td><%= it.unidad %></td>
          <td><%= it.descripcion %></td>
          <td><%= it.lote %></td>
          <td><%= it.importe %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <p class="align-end"><strong>Total: <%= remision.total %></strong></p>
</div>
<%- include('partials/foot') %>
