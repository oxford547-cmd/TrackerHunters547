<%- include('partials/head', { withSidebar: true }) %>
<div class="dash-head">
  <div>
    <h1 class="dash-title lime">Nuevo pedido</h1>
  </div>
  <div class="dash-actions">
    <a class="btn btn-glass" href="/encargado">Volver al dashboard</a>
  </div>
</div>

<div class="card mb">
  <form method="post" action="/encargado/orders" class="form-grid" id="nuevo-pedido-form">
    <label class="span-2">Número de pedido (tracking)
      <input type="text" name="tracking_code" required maxlength="64"
             placeholder="<%= suggestedCode %>"
             autocomplete="off"
             pattern=".{3,64}"
             title="3 a 64 caracteres, único en el portal">
      <span class="muted small"><code class="js-suggest-code"><%= suggestedCode %></code>
        <button type="button" class="btn btn-sm btn-glass js-use-suggest" style="margin-left:.35rem">Usar</button>
      </span>
    </label>
    <label class="span-2">Número de Orden de Compra
      <input type="text" name="purchase_order" maxlength="120" placeholder="OC / PO del cliente (opcional)" autocomplete="off">
    </label>
    <label>Cliente existente (alta)
      <select name="customer_id" id="customer-select">
        <option value="" data-name="" data-phone="" data-email="" data-address="" data-notes="">— Nuevo / manual —</option>
        <% customers.forEach(c => { %>
          <option value="<%= c.id %>"
                  data-name="<%= c.name %>"
                  data-phone="<%= c.phone || '' %>"
                  data-email="<%= c.email || '' %>"
                  data-address="<%= c.address || '' %>"
                  data-notes="<%= c.notes || '' %>">
            <%= c.name %> (<%= c.email || c.phone || 'sin contacto' %>)
          </option>
        <% }) %>
      </select>
    </label>
    <label>Nombre / contacto
      <input type="text" name="customer_name" id="field-name" placeholder="Nombre del cliente">
    </label>
    <label>Email
      <input type="email" name="email" id="field-email" placeholder="avisos de estado" autocomplete="email">
    </label>
    <label>Teléfono
      <input type="text" name="phone" id="field-phone" placeholder="55… o +52…">
    </label>
    <label class="span-2">Dirección
      <input type="text" name="address" id="field-address" placeholder="Calle, colonia, ciudad">
    </label>
    <label class="span-2">Notas
      <textarea name="notes" id="field-notes" rows="2" placeholder="Instrucciones de entrega"></textarea>
    </label>

    <div class="span-2 materials-editor">
      <div class="materials-editor-head">
        <strong>Material enviado</strong>
        <button type="button" class="btn btn-sm btn-glass" id="js-add-item">+ Línea</button>
      </div>
      <div id="materials-rows"></div>
    </div>

    <label>Chofer
      <select name="chofer_id">
        <option value="">— Sin asignar —</option>
        <% choferes.filter(c => c.active).forEach(c => { %>
          <option value="<%= c.id %>"><%= c.name %></option>
        <% }) %>
      </select>
    </label>
    <div class="align-end">
      <button type="submit" class="btn btn-glass-hot">Crear pedido</button>
    </div>
  </form>
</div>
<template id="material-row-tpl">
  <div class="material-row">
    <label>Descripción
      <input type="text" name="item_description[]" placeholder="Material / producto">
    </label>
    <label>Unidad de medida
      <input type="text" name="item_uom[]" placeholder="PZ, KG, M…" value="PZ">
    </label>
    <label>Cantidad
      <input type="number" name="item_quantity[]" min="0.001" step="any" value="1">
    </label>
    <button type="button" class="btn btn-sm btn-danger js-remove-item" title="Quitar línea">×</button>
  </div>
</template>
<script>
document.querySelector('.js-use-suggest')?.addEventListener('click', function () {
  const code = document.querySelector('.js-suggest-code')?.textContent?.trim();
  const input = document.querySelector('input[name="tracking_code"]');
  if (code && input) input.value = code;
});

(function autofillFromAlta() {
  const sel = document.getElementById('customer-select');
  if (!sel) return;
  const name = document.getElementById('field-name');
  const phone = document.getElementById('field-phone');
  const email = document.getElementById('field-email');
  const address = document.getElementById('field-address');
  const notes = document.getElementById('field-notes');
  function apply() {
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    if (name) name.value = opt.getAttribute('data-name') || '';
    if (phone) phone.value = opt.getAttribute('data-phone') || '';
    if (email) email.value = opt.getAttribute('data-email') || '';
    if (address) address.value = opt.getAttribute('data-address') || '';
    if (notes) notes.value = opt.getAttribute('data-notes') || '';
  }
  sel.addEventListener('change', apply);
})();

(function materialsEditor() {
  const wrap = document.getElementById('materials-rows');
  const tpl = document.getElementById('material-row-tpl');
  const addBtn = document.getElementById('js-add-item');
  if (!wrap || !tpl || !addBtn) return;

  function addRow() {
    const node = tpl.content.cloneNode(true);
    const row = node.querySelector('.material-row');
    row.querySelector('.js-remove-item').addEventListener('click', () => {
      if (wrap.querySelectorAll('.material-row').length <= 1) {
        row.querySelectorAll('input').forEach((inp) => {
          if (inp.name === 'item_quantity[]') inp.value = '1';
          else if (inp.name === 'item_uom[]') inp.value = 'PZ';
          else inp.value = '';
        });
        return;
      }
      row.remove();
    });
    wrap.appendChild(node);
  }

  addBtn.addEventListener('click', addRow);
  addRow();
})();
</script>
<%- include('partials/foot') %>
