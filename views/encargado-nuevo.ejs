<%- include('partials/head', { withSidebar: true }) %>
<div class="dash-head">
  <div>
    <h1 class="dash-title lime">Nuevo pedido</h1>
    <p class="muted">Asigna el <strong>número de pedido</strong> manualmente. Debe ser único en este portal.</p>
  </div>
  <div class="dash-actions">
    <a class="btn btn-glass" href="/encargado">Volver al dashboard</a>
  </div>
</div>

<div class="card mb">
  <form method="post" action="/encargado/orders" class="form-grid" id="nuevo-pedido-form">
    <label class="span-2">Número de pedido (tracking)
      <input type="text" name="tracking_code" required maxlength="64"
             placeholder="Ej. <%= suggestedCode %>"
             autocomplete="off"
             pattern=".{3,64}"
             title="3 a 64 caracteres, único en el portal">
      <span class="muted small">Sugerencia: <code class="js-suggest-code"><%= suggestedCode %></code>
        <button type="button" class="btn btn-sm btn-glass js-use-suggest" style="margin-left:.35rem">Usar sugerencia</button>
      </span>
    </label>
    <label>Orden de compra (OC)
      <input type="text" name="purchase_order" maxlength="80" placeholder="OC / referencia del cliente">
    </label>
    <label>Cliente existente (alta)
      <select name="customer_id" id="customer-select">
        <option value="" data-name="" data-phone="" data-email="" data-address="" data-notes="">— Nuevo / manual —</option>
        <% customers.forEach(c => { %>
          <option value="<%= c.id %>"
                  data-name="<%= c.name %>"
                  data-phone="<%= c.phone || '' %>"
                  data-email="<%= c.email || '' %>"
                  data-address="<%= c.address || '' %>"
                  data-notes="<%= c.notes || '' %>">
            <%= c.name %> (<%= c.phone || 'sin tel' %>)
          </option>
        <% }) %>
      </select>
      <span class="muted small">Al elegir un cliente se rellenan contacto, teléfono, email, dirección y notas.</span>
    </label>
    <label>Nombre / contacto
      <input type="text" name="customer_name" id="field-name" placeholder="Nombre del cliente">
    </label>
    <label>Teléfono
      <input type="text" name="phone" id="field-phone" placeholder="55… o +52…">
    </label>
    <label>Email (avisos de estado)
      <input type="email" name="email" id="field-email" placeholder="cliente@empresa.com">
    </label>
    <label class="span-2">Dirección
      <input type="text" name="address" id="field-address" placeholder="Calle, colonia, ciudad">
    </label>
    <label class="span-2">Notas
      <textarea name="notes" id="field-notes" rows="2" placeholder="Instrucciones de entrega"></textarea>
    </label>
    <label>Chofer
      <select name="chofer_id">
        <option value="">— Sin asignar —</option>
        <% choferes.filter(c => c.active).forEach(c => { %>
          <option value="<%= c.id %>"><%= c.name %></option>
        <% }) %>
      </select>
    </label>
    <div class="span-2">
      <h2 class="form-section">Partidas / material</h2>
      <p class="muted small">Descripción, unidad y cantidad. Deja vacías las filas que no uses.</p>
      <div class="table-wrap">
        <table class="table" id="items-table">
          <thead>
            <tr><th>Descripción</th><th>UoM</th><th>Cantidad</th></tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < 4; i++) { %>
            <tr>
              <td><input type="text" name="item_description" placeholder="Material / servicio"></td>
              <td><input type="text" name="item_uom" placeholder="PZA, KG…"></td>
              <td><input type="number" name="item_qty" step="0.01" min="0" placeholder="0"></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <button type="button" class="btn btn-sm btn-glass js-add-item" style="margin-top:.5rem">+ Partida</button>
    </div>
    <div class="align-end">
      <button type="submit" class="btn btn-glass-hot">Crear pedido</button>
    </div>
  </form>
</div>
<script>
document.querySelector('.js-use-suggest')?.addEventListener('click', function () {
  const code = document.querySelector('.js-suggest-code')?.textContent?.trim();
  const input = document.querySelector('input[name="tracking_code"]');
  if (code && input) input.value = code;
});

(function autofillFromAlta() {
  const sel = document.getElementById('customer-select');
  if (!sel) return;
  const name = document.getElementById('field-name');
  const phone = document.getElementById('field-phone');
  const email = document.getElementById('field-email');
  const address = document.getElementById('field-address');
  const notes = document.getElementById('field-notes');
  function apply() {
    const opt = sel.options[sel.selectedIndex];
    if (!opt || !opt.value) return;
    if (name) name.value = opt.getAttribute('data-name') || '';
    if (phone) phone.value = opt.getAttribute('data-phone') || '';
    if (email) email.value = opt.getAttribute('data-email') || '';
    if (address) address.value = opt.getAttribute('data-address') || '';
    if (notes) notes.value = opt.getAttribute('data-notes') || '';
  }
  sel.addEventListener('change', apply);
})();

document.querySelector('.js-add-item')?.addEventListener('click', function () {
  const tbody = document.querySelector('#items-table tbody');
  if (!tbody) return;
  const tr = document.createElement('tr');
  tr.innerHTML = '<td><input type="text" name="item_description" placeholder="Material / servicio"></td>' +
    '<td><input type="text" name="item_uom" placeholder="PZA, KG…"></td>' +
    '<td><input type="number" name="item_qty" step="0.01" min="0" placeholder="0"></td>';
  tbody.appendChild(tr);
});
</script>
<%- include('partials/foot') %>
