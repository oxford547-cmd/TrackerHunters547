<%- include('partials/head', { withSidebar: true }) %>
<div class="dash-head">
  <div>
    <h1 class="dash-title lime">Nueva remisión</h1>
    <p class="muted">El folio se asigna al guardar (consecutivo del portal).</p>
  </div>
  <div class="dash-actions">
    <a class="btn btn-glass" href="/encargado/remisiones">Volver</a>
  </div>
</div>

<div class="card mb">
  <form method="post" action="/encargado/remisiones" class="form-grid" id="remision-form">
    <label>Cliente
      <select id="rem-customer">
        <option value="" data-name="">— Manual —</option>
        <% customers.forEach(c => { %>
          <option value="<%= c.id %>" data-name="<%= c.name %>"><%= c.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Nombre del cliente *
      <input type="text" name="customer_name" id="rem-customer-name" required>
    </label>
    <label>Fecha
      <input type="date" name="fecha" value="<%= new Date().toISOString().slice(0,10) %>">
    </label>
    <label>Empresa (encabezado)
      <input type="text" name="company_name" value="<%= portal && portal.name ? portal.name : '' %>">
    </label>
    <label class="span-2">Dirección empresa
      <input type="text" name="company_address" value="<%= portal && portal.address ? portal.address : '' %>">
    </label>
    <div class="span-2">
      <h2 class="form-section">Partidas</h2>
      <div class="table-wrap">
        <table class="table" id="rem-items">
          <thead>
            <tr>
              <th>Cant.</th>
              <th>Unidad</th>
              <th>Descripción</th>
              <th>Lote</th>
              <th>Importe</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < 4; i++) { %>
            <tr>
              <td><input type="number" name="item_cantidad" step="0.01" min="0"></td>
              <td><input type="text" name="item_unidad" placeholder="PZA"></td>
              <td><input type="text" name="item_descripcion"></td>
              <td><input type="text" name="item_lote"></td>
              <td><input type="number" name="item_importe" step="0.01" min="0"></td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <button type="button" class="btn btn-sm btn-glass js-add-rem-item" style="margin-top:.5rem">+ Partida</button>
    </div>
    <div class="align-end">
      <button type="submit" class="btn btn-glass-hot">Guardar remisión</button>
    </div>
  </form>
</div>
<script>
document.getElementById('rem-customer')?.addEventListener('change', function () {
  const opt = this.options[this.selectedIndex];
  const name = document.getElementById('rem-customer-name');
  if (opt && opt.value && name) name.value = opt.getAttribute('data-name') || '';
});
document.querySelector('.js-add-rem-item')?.addEventListener('click', function () {
  const tbody = document.querySelector('#rem-items tbody');
  if (!tbody) return;
  const tr = document.createElement('tr');
  tr.innerHTML = '<td><input type="number" name="item_cantidad" step="0.01" min="0"></td>' +
    '<td><input type="text" name="item_unidad" placeholder="PZA"></td>' +
    '<td><input type="text" name="item_descripcion"></td>' +
    '<td><input type="text" name="item_lote"></td>' +
    '<td><input type="number" name="item_importe" step="0.01" min="0"></td>';
  tbody.appendChild(tr);
});
</script>
<%- include('partials/foot') %>
