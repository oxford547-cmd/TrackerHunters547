<% const matItems = typeof items !== 'undefined' && items ? items : []; %>
<% if (matItems.length) { %>
<div class="materials-block">
  <h3 class="materials-title">Material enviado</h3>
  <div class="table-wrap">
    <table class="table table-compact">
      <thead>
        <tr>
          <th>Descripción</th>
          <th>Unidad</th>
          <th>Cantidad</th>
        </tr>
      </thead>
      <tbody>
        <% matItems.forEach(it => { %>
        <tr>
          <td><%= it.description %></td>
          <td><%= it.uom || '—' %></td>
          <td><%= it.quantity %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
