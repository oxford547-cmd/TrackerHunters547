# Secrets — never commit real Twilio tokens or API keys
PORT=3000
SESSION_SECRET=cambia-esto-en-produccion
DB_PATH=data/pedidos.sqlite

# WhatsApp via Twilio. wa.me cannot push from the server.
# If any of these three is missing, messages are logged only.
# When a portal has whatsapp_number, that number is the preferred Twilio FROM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Supabase client at repo-root db.js (placeholders only — this sync does not create schema)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_API_KEY=
