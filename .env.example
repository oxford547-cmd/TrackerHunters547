# Secrets and local env — never commit real Twilio tokens
PORT=3000
SESSION_SECRET=cambia-esto-en-produccion
DB_PATH=data/pedidos.sqlite

# WhatsApp (Twilio). wa.me / api.whatsapp.com cannot push from the server.
# Without keys the app only logs the intended message (demo).
WHATSAPP_PROVIDER=twilio
# WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# PUBLIC_BASE_URL=https://tu-dominio.example
# WHATSAPP_NOTIFY_CANCELADO=true
