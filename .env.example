# Copy to .env — never commit real keys.

PORT=3000
NODE_ENV=development
SESSION_SECRET=cambia-esto-en-produccion

# Public URL used in email rastreo links (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# Supabase (server only). Service role bypasses RLS — never ship to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias if you prefer this name instead of SERVICE_ROLE_KEY
# SUPABASE_API_KEY=

# Email status notifications (Hostinger SSL). If SMTP_HOST is missing, messages are logged only.
# SMTP_PASS goes only in the server .env — never commit it.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@hunters547.cloud
SMTP_PASS=
SMTP_FROM=Hunters 547 <info@hunters547.cloud>
# MAIL_FROM is an optional alias for SMTP_FROM (same value).
# MAIL_FROM=Hunters 547 <info@hunters547.cloud>
