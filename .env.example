# Secrets — never commit real Twilio tokens
PORT=3000
SESSION_SECRET=cambia-esto-en-produccion
DB_PATH=data/pedidos.sqlite

# WhatsApp via Twilio. wa.me cannot push from the server.
# If any of these three is missing, messages are logged only.
# When a portal has whatsapp_number, that number is the preferred Twilio FROM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
