# Copy to .env — never commit real keys.

PORT=3000
NODE_ENV=development
SESSION_SECRET=cambia-esto-en-produccion

# Public URL used in email rastreo links (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# Supabase (server only). Service role bypasses RLS — never ship to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias if you prefer this name instead of SERVICE_ROLE_KEY
# SUPABASE_API_KEY=

# Email status notifications. If SMTP_* is incomplete, messages are logged only.
# Hostinger SMTP (SSL):
#   SMTP_HOST=smtp.hostinger.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=info@yourdomain
#   SMTP_PASS=
#   SMTP_FROM=info@yourdomain
# MAIL_FROM is accepted as an alias for SMTP_FROM.
# From display name is always "Notificaciones" (address only in SMTP_FROM / MAIL_FROM).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@yourdomain
SMTP_PASS=
SMTP_FROM=info@yourdomain
