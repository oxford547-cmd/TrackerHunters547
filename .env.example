# Copy to .env — never commit real keys.

PORT=3000
SESSION_SECRET=cambia-esto-en-produccion

# Public URL used in email rastreo links (no trailing slash)
PUBLIC_BASE_URL=http://localhost:3000

# Supabase (server only). Service role bypasses RLS — never ship to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional alias if you prefer this name instead of SERVICE_ROLE_KEY
# SUPABASE_API_KEY=

# Email status notifications (not WhatsApp). If SMTP_* is incomplete, messages are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=false
