# Secrets — never commit real SMTP passwords or API keys
PORT=3000
SESSION_SECRET=cambia-esto-en-produccion
DB_PATH=data/pedidos.sqlite

# Public URL for rastreo links in emails (no trailing slash)
# PUBLIC_BASE_URL=https://pedidos.example.com

# SMTP email notifications (order create / status / cancel / deliver)
# If SMTP_HOST, SMTP_PORT or MAIL_FROM is missing, messages are logged only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hunters 547 <noreply@example.com>"
# SMTP_SECURE=false

# Optional unused-by-core Supabase client (root db.js). Leave empty for local demo.
# No schema or migrations are applied from this repo.
SUPABASE_URL=
SUPABASE_API_KEY=
